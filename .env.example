# hr360 設定。建議用 ./setup.sh（Windows：.\setup.ps1）產生 .env，它會自動填好所有密碼與金鑰，
# 只會問你要接哪個模型。手動設定的話：複製成 .env，填好標示「必填」的欄位。

# ─── 模型（接你們自己的 AI）────────────────────────────────────────────
# anthropic：Claude 官方 API
# foundry：Microsoft Foundry 上的 Claude（LLM_FOUNDRY_RESOURCE 填資源名稱，模型名稱填部署名稱）
# openai_compatible：Azure OpenAI（v1 端點）、vLLM、Ollama、LiteLLM 等 Chat Completions 相容端點
# 沒填 LLM_API_KEY 也能啟動：查詢、請假、簽核都可用，只有 HR 助理聊天會提示尚未設定
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
LLM_FOUNDRY_RESOURCE=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_STRONG=claude-sonnet-5-5
# 讀取上傳證明文件的模型（須支援影像）；留空則用 LLM_MODEL_FAST
LLM_MODEL_VISION=
# openai_compatible 的推理模型（例如 Ollama qwen3.5）建議設 none，避免 token 全花在思考
LLM_REASONING_EFFORT=

# ─── 密碼與金鑰（必填；setup.sh 會自動產生）───────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
# 所有示範帳號共用的密碼
SEED_DEMO_PASSWORD=

# ─── 網路 ──────────────────────────────────────────────────────────────
# 網頁入口：http://localhost:3000。要讓同網段其他人連線，把 WEB_BIND 改成 0.0.0.0
WEB_PORT=3000
WEB_BIND=127.0.0.1
# API 與 MCP（/mcp）只開放本機；資料庫只開放本機
API_PORT=8360
DB_PORT=5433
# 用 HTTPS 對外時改成 true
COOKIE_SECURE=false
ENABLE_API_DOCS=false

# ─── 示範資料 ──────────────────────────────────────────────────────────
# 第一次啟動且資料庫為空時，自動產生示範員工資料與匯入規章知識庫
SEED_ON_START=true
# 示範資料的「今天」；正式資料請留空
APP_TODAY=2026-11-10

# ─── 本機開發（不經 Docker 直接跑 alembic、pytest、評測時）──────────
DATABASE_URL=postgresql+psycopg://hr360:<POSTGRES_PASSWORD>@localhost:5433/hr360
